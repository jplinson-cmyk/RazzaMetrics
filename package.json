{
  "name": "razza-seo-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "vitest run tests/platform.test.ts",
    "dev:server": "node scripts/dev-worker.mjs",
    "db:migrate": "wrangler d1 migrations apply razza-seo --local",
    "deploy": "npm run build && wrangler deploy --env production",
    "lint": "eslint src server tests",
    "test:e2e": "node scripts/test-e2e.mjs"
  },
  "dependencies": {
    "@types/papaparse": "^5.5.2",
    "cheerio": "^1.2.0",
    "lucide-react": "^0.475.0",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.13.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  },
  "description": "Razza Consulting SEO monitoring and auditing platform"
}

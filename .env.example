# Copy to .dev.vars for wrangler local development. Never use VITE_ for secrets.
APP_BASE_URL=http://localhost:8787
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional manual admin login. Password is PBKDF2-SHA256 (100000 iterations), saltHex:hashHex.
MANUAL_ADMIN_USERNAME=admin
MANUAL_ADMIN_PASSWORD_HASH=
# Base64-encoded 32 random bytes. Example: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
ALLOWED_EMAIL_DOMAIN=razzaconsulting.com
GOOGLE_PAGESPEED_API_KEY=
CRAWLER_MAX_PAGES=25
CRAWLER_MAX_DEPTH=3
CRAWLER_REQUEST_TIMEOUT_MS=10000
CRAWLER_USER_AGENT=RazzaSEO-Crawler/2.0
DAILY_CRAWL_PAGE_LIMIT=100
DAILY_PAGESPEED_REQUEST_LIMIT=10
DAILY_GSC_REQUEST_LIMIT=2000
DATA_RETENTION_DAYS=400
# Open PageRank is disabled until a compliant fixed-egress adapter is supplied.
OPEN_PAGERANK_ADAPTER_URL=
OPEN_PAGERANK_ADAPTER_TOKEN=
DAILY_OPEN_PAGERANK_REQUEST_LIMIT=10
# Free Bing Webmaster Tools API key (Settings > API access) for "Import from Bing" on Backlink Profile.
BING_WEBMASTER_API_KEY=
DAILY_BING_REQUEST_LIMIT=50
